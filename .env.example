# =========================================================================
# Ford FIAP Challenge — Environment Variables
# =========================================================================
# Para rodar local: copie este arquivo para .env.local e preencha.
# .env.local NUNCA vai pro git (está no .gitignore).
# Em CI, use GitHub Actions Secrets — nunca cole valores aqui.
# =========================================================================

# ----- PostgreSQL (banco padrão) -----
# Connection string do banco da aplicação. Local: PG rodando em 127.0.0.1.
# Migrations: pnpm db:migrate | seed: pnpm db:seed && pnpm db:seed:admin
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/faroai

# ----- Auth própria (API emite JWT HS256) -----
# Mínimo 32 chars. Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<hex-de-64-chars>
JWT_EXPIRES_IN=12h

# ----- Anthropic Claude (insights de IA) -----
# Usar Haiku para XAI per-client (barato), Sonnet para análises de carteira.
ANTHROPIC_API_KEY=<sk-ant-...>
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-4-6

# ----- API Gateway (Node + Fastify) -----
API_PORT=3333
API_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,exp://192.168.1.0:8081
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
# Proxy reverso confiável (X-Forwarded-For/Proto). Deixe false a não ser que a
# API esteja ATRÁS de um proxy que sobrescreve esses headers (nginx, ALB...);
# com true sem proxy, qualquer cliente forja o IP e burla o rate-limit do login.
# Aceita: false | true | número de hops | IPs/CIDRs separados por vírgula
# (ex.: 127.0.0.1,10.0.0.0/8 ou loopback).
TRUST_PROXY=false

# URL do serviço de ML (Python FastAPI)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=<shared-secret-entre-api-e-ml>

# ----- ML Service (Python + FastAPI) -----
ML_PORT=8001
MODELS_DIR=./services/ml/models
SYNTHETIC_DATA_DIR=./services/ml/data

# ----- Mobile/Web — apenas chaves PÚBLICAS aqui -----
# Vai em apps/mobile/.env.local e apps/web/.env.local com prefixo EXPO_PUBLIC_*
EXPO_PUBLIC_API_URL=http://localhost:3333
