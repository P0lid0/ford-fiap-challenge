{
  "name": "ford-fiap-challenge",
  "version": "0.1.0",
  "private": true,
  "description": "Ford FIAP Challenge 2026 — Faro AI",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @ford/api dev",
    "dev:mobile": "pnpm --filter @ford/mobile start",
    "dev:ml": "cd services/ml && python -m uvicorn src.main:app --reload --port 8001",
    "build": "pnpm -r --filter './apps/*' --filter './packages/*' build",
    "lint": "pnpm -r --filter './apps/*' --filter './packages/*' lint",
    "typecheck": "pnpm -r --filter './apps/*' --filter './packages/*' typecheck",
    "test": "pnpm -r --filter './apps/*' test",
    "ml:train": "cd services/ml && python -m src.scripts.train_models",
    "ml:test": "cd services/ml && python -m pytest",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:status": "node scripts/db-migrate.mjs --status",
    "db:seed": "node scripts/seed-vehicles.mjs",
    "db:seed:admin": "node scripts/db-seed-admin.mjs",
    "db:seed:demo": "node scripts/db-seed-demo.mjs",
    "db:user": "node scripts/db-create-user.mjs",
    "db:create-user": "node scripts/db-create-user.mjs"
  },
  "dependencies": {
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "@types/node": "22.10.2",
    "pptxgenjs": "^4.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
